
<section
  class="northfold-product"
  style="background-color: {{ section.settings.background_color }};"
>
  {% if product == blank %}
    <p>Please select a product to preview this section.</p>
  {% else %}
    <div class="northfold-product__layout">
      <div class="northfold-product__gallery">
        {% for image in product.images %}
          <div class="northfold-product__image">
            {{
              image
              | image_url: width: 1200
              | image_tag:
                widths: '360, 540, 720, 960, 1200',
                sizes: '(min-width: 750px) 55vw, 100vw',
                alt: image.alt
            }}
          </div>
        {% else %}
          <p>No product images are available.</p>
        {% endfor %}
      </div>

      <div class="northfold-product__details">
        <h1>{{ product.title | escape }}</h1>

        <p class="northfold-product__price" aria-live="polite">
          {{ product.selected_or_first_available_variant.price | money }}
        </p>

        <div class="northfold-product__description">
          {{ product.description }}
        </div>

        {% form 'product', product %}
          {% if product.has_only_default_variant %}
            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
            >
          {% else %}
            <label for="NorthfoldVariant-{{ section.id }}">
              Choose an option
            </label>

            <select
              id="NorthfoldVariant-{{ section.id }}"
              name="id"
            >
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price | money | escape }}"
                  data-available="{{ variant.available }}"
                  {% if variant.id == product.selected_or_first_available_variant.id %}
                    selected
                  {% endif %}
                  {% unless variant.available %}
                    disabled
                  {% endunless %}
                >
                  {{ variant.title | escape }}
                  — {{ variant.price | money }}
                  {% unless variant.available %}
                    - Sold out
                  {% endunless %}
                </option>
              {% endfor %}
            </select>
          {% endif %}

          {% if section.settings.show_quantity %}
            <label for="NorthfoldQuantity-{{ section.id }}">
              Quantity
            </label>
            <input
              id="NorthfoldQuantity-{{ section.id }}"
              type="number"
              name="quantity"
              min="1"
              value="1"
            >
          {% endif %}

          <button
            type="submit"
            name="add"
            {% unless product.selected_or_first_available_variant.available %}
              disabled
            {% endunless %}
          >
            {% if product.selected_or_first_available_variant.available %}
              Add to cart
            {% else %}
              Sold out
            {% endif %}
          </button>
        {% endform %}
      </div>
    </div>
  {% endif %}

  {% render 'northfold-benefits',
    heading: section.settings.benefits_heading,
    blocks: section.blocks
  %}
</section>

{% javascript %}
  document.addEventListener('change', (event) => {
    const variantSelect = event.target;

    if (!(variantSelect instanceof HTMLSelectElement) || variantSelect.name !== 'id') {
      return;
    }

    const productSection = variantSelect.closest('.northfold-product');
    const selectedOption = variantSelect.selectedOptions[0];
    const price = productSection?.querySelector('.northfold-product__price');
    const submitButton = productSection?.querySelector('button[name="add"]');

    if (!productSection || !selectedOption || !price || !submitButton) {
      return;
    }

    price.textContent = selectedOption.dataset.price ?? '';
    submitButton.disabled = selectedOption.dataset.available !== 'true';
    submitButton.textContent = submitButton.disabled ? 'Sold out' : 'Add to cart';
  });
{% endjavascript %}

{% stylesheet %}
  .northfold-product {
    padding: 32px 5%;
  }

  .northfold-product__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .northfold-product__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-content: start;
  }

  .northfold-product__image:first-child {
    grid-column: 1 / -1;
  }

  .northfold-product__image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .northfold-product__details {
    min-width: 0;
  }

  .northfold-product__price {
    font-size: 1.4rem;
    font-weight: 700;
  }

  .northfold-product__description {
    line-height: 1.6;
  }

  .northfold-product__details form {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }

  .northfold-product__details select,
  .northfold-product__details input,
  .northfold-product__details button {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    padding: 12px;
    font: inherit;
  }

  .northfold-product__details button {
    cursor: pointer;
  }

  .northfold-product__benefits {
    max-width: 1200px;
    margin: 48px auto 0;
  }

  .northfold-product__benefits h2 {
    text-align: center;
  }

  .northfold-product__benefit-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .northfold-product__benefit {
    padding: 16px;
    border: 1px solid currentColor;
    border-radius: 8px;
  }

  .northfold-product :focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .northfold-product__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .northfold-product__benefit-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Northfold product",
  "settings": [
    {
      "type": "text",
      "id": "benefits_heading",
      "label": "Benefits heading",
      "default": "Made for everyday moments"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#F8F6F1"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity input",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Benefit title",
          "default": "Thoughtful design"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Benefit text",
          "default": "Designed to fit into everyday life."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Northfold product",
      "blocks": [
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        }
      ]
    }
  ]
}
{% endschema %}
