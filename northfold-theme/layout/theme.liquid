<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

    {{ 'recently-viewed.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>
  </head>

  <body>
    {% sections 'header-group' %}

    {% if template.name == 'product' %}
      {% render 'recently-viewed-record', product: product %}
    {% endif %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
